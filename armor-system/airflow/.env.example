# Copy to .env before `docker compose up`. .env is Git-ignored; never commit it.

# Host port for the Airflow UI. The container always listens on 8080 inside;
# this is only the port published on the host. 8080 and 8081 may already be in
# use by another Airflow stack on this machine.
AIRFLOW_PORT=8088

# Run containers as your host user so generated artifacts are not owned by root.
# Linux/macOS: id -u    Windows (Docker Desktop): leave the default.
AIRFLOW_UID=50000

# Local development login for the Airflow UI. Change both before exposing this
# to anything other than localhost.
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_ADMIN_EMAIL=admin@localhost

# Alerting. A failed task always writes an alert block to its log and a JSON
# record to /opt/airflow/workspace/alerts/alerts.jsonl, with no configuration at
# all. The two settings below add a notification that leaves the machine.
#
# A webhook is the easiest to set up and needs no account credentials in the
# image: create an incoming webhook in Slack or Discord and paste the URL. The
# same payload works for both.
ALERT_WEBHOOK_URL=

# Email. Leave SMTP_HOST empty or set to localhost and the email sink reports
# itself as unconfigured instead of pretending to send. For Gmail use
# smtp.gmail.com, port 587, and an app password as SMTP_PASSWORD.
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=airflow@localhost
SMTP_USER=
SMTP_PASSWORD=
