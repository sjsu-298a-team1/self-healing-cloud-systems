# Copy to .env. .env is Git-ignored; never commit it.

# Where the ten Model 1 v1 checkpoint files live on THIS machine.
# The directory must contain model1_v1/seed_{0..4}/s2_best.pt and s2_best.json.
# They are 3.5 MB, kept outside Git. Ask Khushi for a copy.
#
# The service hashes every file against the frozen test evidence at start-up and
# refuses to run if any is missing or altered, so a wrong path fails loudly.
MODEL1_CHECKPOINT_DIR=C:/Users/bhoom/298A_project/checkpoints

# Host port for the service. 8080 and 8081 are already taken on this machine by
# another Airflow stack, so the default is 8082. The container always listens on
# 8081 internally.
MODEL1_PUBLISHED_PORT=8082

# Leave at 1. Every published latency figure was produced single-threaded;
# changing it makes the numbers incomparable.
MODEL1_TORCH_THREADS=1
